SCHEDULE_RULES_FILE = DATA_DIR / "schedule_rules.json"

def get_schedule_rules():
    if not SCHEDULE_RULES_FILE.exists():
        default_rules = {
            "slots": ["08:00", "11:30", "17:30", "20:30"],
            "stagger_min": 5,
            "stagger_max": 15,
            "max_posts_per_page_day": 4,
            "auto_comment": True,
            "include_website_link": True,
            "folder_binding_mode": "round_robin",
            "updated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        }
        try:
            with open(SCHEDULE_RULES_FILE, "w", encoding="utf-8") as f:
                json.dump(default_rules, f, indent=2, ensure_ascii=False)
        except Exception:
            pass
        return default_rules
    try:
        with open(SCHEDULE_RULES_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}

def save_schedule_rules(data):
    data["updated_at"] = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    try:
        with open(SCHEDULE_RULES_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
    except Exception as e:
        print("Error saving schedule rules:", e)
    return data

