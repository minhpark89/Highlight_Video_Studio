  <!-- MODAL 2: TẠO BÀI VIẾT VIRAL, FIRST COMMENT GÂY TÒ MÒ & THUMBNAIL -->
  <div id="modal-content-writer" class="app-modal-overlay">
    <div class="app-modal-box" style="max-width: 980px;">
      <div class="app-modal-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(245, 158, 11, 0.2); color: #f59e0b; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-stars"></i>
          </div>
          <div>
            <h4 style="font-size: 15px; font-weight: 700; margin: 0;">AI Viral Content & First Comment Studio</h4>
            <span style="font-size: 11px; color: #94a3b8;">Viết bài Facebook cuốn hút + First Comment kích thích tò mò cực độ</span>
          </div>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="closeContentWriterModal()" style="border-radius: 50%; width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center;">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="app-modal-body">

          <!-- VIDEO PLAYER NỘI BỘ (Xem trực tiếp clip highlight trước khi viết bài & post, tuyệt đối không ra ngoài) -->
          <div id="ai-writer-video-box" style="margin-bottom: 20px; background: #0b1329; border: 1px solid #23304d; border-radius: 12px; padding: 12px; display: flex; align-items: center; gap: 15px;">
            <div style="width: 140px; height: 180px; border-radius: 8px; overflow: hidden; background: #000; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1px solid #1e293b;">
              <video id="ai-writer-video-elem" controls style="width: 100%; height: 100%; object-fit: contain; background: #000;">
                <source id="ai-writer-video-src" src="" type="video/mp4">
              </video>
            </div>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <span class="badge" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; font-size: 11px; padding: 2px 8px; border-radius: 4px;">VIDEO HIGHLIGHT NỘI BỘ</span>
                <span id="ai-writer-clip-name" style="font-size: 12px; color: #94a3b8; font-family: monospace;"></span>
              </div>
              <div id="ai-writer-clip-title" style="font-size: 13.5px; font-weight: 700; color: #f8fafc; margin-bottom: 8px; line-height: 1.4;"></div>
              <div style="font-size: 11.5px; color: #64748b; line-height: 1.4;">
                <i class="bi bi-play-circle text-info"></i> Clip được phát trực tiếp từ máy trạm PC. Quy trình: <strong>Xem video &rarr; Sinh nội dung AI &rarr; Đăng Reels & Comment lên Fanpage</strong>.
              </div>
            </div>
          </div>

        <!-- Input Context -->
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 15px; margin-bottom: 20px;">
          <div>
            <label class="form-label" style="font-size: 12px; font-weight: 600; color: #94a3b8;">Tiêu đề Video / Chủ đề:</label>
            <input type="text" id="ai-writer-title" class="form-control" style="font-size: 13px; font-weight: 600;" placeholder="Nhập tiêu đề hoặc chủ đề video...">
          </div>
          <div>
            <label class="form-label" style="font-size: 12px; font-weight: 600; color: #94a3b8;">Hành động:</label>
            <div style="display: flex; gap: 8px;">
              <button id="btn-trigger-ai-write" class="btn btn-primary" style="flex: 1; justify-content: center; font-weight: 700; background: linear-gradient(135deg, #f59e0b, #ea580c); border: none;" onclick="triggerAiContentGen()">
                <i class="bi bi-sparkles"></i> <span>Tạo nội dung AI</span>
              </button>
            </div>
          </div>
        </div>

        <div id="ai-writer-loading" style="display: none; padding: 30px; text-align: center;">
          <div class="spinner-border text-warning" role="status" style="width: 2.5rem; height: 2.5rem;"></div>
          <div style="margin-top: 12px; font-weight: 600; color: #f59e0b;">AI 9router (Gemini) đang phân tích và sáng tạo nội dung kịch tính...</div>
        </div>

        <!-- Output Result Section -->
        <div id="ai-writer-results" style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px;">
          <!-- Left Col: Post & First comment -->
          <div>
            <!-- Viral Title -->
            <label class="form-label" style="font-size: 12px; font-weight: 700; color: #f59e0b;">
              <i class="bi bi-megaphone-fill"></i> TIÊU ĐỀ VIRAL HOOK (3s GIỮ CHÂN):
            </label>
            <div class="copy-box-field">
              <button class="copy-box-btn" onclick="copyBoxText('out-viral-title', this)"><i class="bi bi-clipboard"></i> Copy</button>
              <textarea id="out-viral-title" rows="2" style="font-weight: 700; color: #fbbf24;"></textarea>
            </div>

            <!-- Facebook Post -->
            <label class="form-label" style="font-size: 12px; font-weight: 700; color: #38bdf8;">
              <i class="bi bi-facebook"></i> BÀI VIẾT FACEBOOK VIRAL HOÀN CHỈNH:
            </label>
            <div class="copy-box-field">
              <button class="copy-box-btn" onclick="copyBoxText('out-fb-post', this)"><i class="bi bi-clipboard"></i> Copy</button>
              <textarea id="out-fb-post" rows="9"></textarea>
            </div>

            <!-- FIRST COMMENT CURIOSITY GAP -->
            <label class="form-label" style="font-size: 12px; font-weight: 700; color: #ec4899;">
              <i class="bi bi-chat-left-dots-fill"></i> FIRST COMMENT GÂY TÒ MÒ CỰC ĐỘ (GHIM TOP BÌNH LUẬN):
            </label>
            <div class="copy-box-field" style="border-color: rgba(236, 72, 153, 0.4); background: #130d1e;">
              <button class="copy-box-btn" style="color: #f472b6; border-color: #ec4899;" onclick="copyBoxText('out-first-comment', this)"><i class="bi bi-clipboard"></i> Copy</button>
              <textarea id="out-first-comment" rows="3" style="color: #fbcfe8; font-weight: 600;"></textarea>
            </div>
          </div>

          <!-- Right Col: Thumbnail Preview & Render -->
          <div>
            <label class="form-label" style="font-size: 12px; font-weight: 700; color: #a855f7;">
              <i class="bi bi-image-fill"></i> ẢNH THUMBNAIL PHONG CÁCH LONGFORM STUDIO:
            </label>
            <div style="background: #0d1527; border: 1px solid #23304d; border-radius: 12px; padding: 12px; text-align: center;">
              <div id="thumb-preview-box" style="width: 100%; min-height: 220px; background: #080c16; border-radius: 8px; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative;">
                <img id="thumb-preview-img" src="" style="width: 100%; height: auto; display: none; border-radius: 6px;">
                <div id="thumb-placeholder" style="color: #64748b; font-size: 12px; padding: 20px;">
                  <i class="bi bi-card-image" style="font-size: 3rem; display: block; margin-bottom: 8px; opacity: 0.4;"></i>
                  Bấm nút bên dưới để render ảnh thumbnail có chữ vàng neon viền đen
                </div>
              </div>

              <div style="margin-top: 12px; display: flex; flex-direction: column; gap: 8px;">
                <button id="btn-render-thumb" class="btn btn-secondary btn-sm" style="width: 100%; justify-content: center; background: #1e293b; border-color: #8b5cf6; color: #a855f7; font-weight: 700;" onclick="renderThumbnailAction()">
                  <i class="bi bi-brush"></i> Tạo Thumbnail Bắt Mắt
                </button>
                <a id="btn-download-thumb" href="#" download="thumbnail.jpg" class="btn btn-primary btn-sm" style="width: 100%; justify-content: center; display: none;">
                  <i class="bi bi-download"></i> Tải ảnh Thumbnail
                </a>
              </div>
            </div>

            <!-- Gợi ý Hashtags -->
            <div style="margin-top: 15px; background: #0d1527; border: 1px solid #23304d; border-radius: 12px; padding: 12px;">
              <span style="font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase;">Hashtags gợi ý:</span>
              <div id="out-hashtags" style="margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <!-- MODAL XEM CHI TIẾT JOB (HÀNG ĐỢI JOBS) -->
  <div id="jobDetailModal" class="app-modal-overlay" style="display:none;" onclick="if(event.target===this) closeJobDetailModal()">
    <div class="app-modal-box" style="max-width: 800px;">
      <div class="app-modal-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div class="brand-icon-box" style="width: 34px; height: 34px; background: rgba(56, 189, 248, 0.15); color: #38bdf8; display: flex; align-items: center; justify-content: center; border-radius: 8px;">
            <i class="bi bi-info-circle-fill"></i>
          </div>
          <div>
            <h4 id="job-detail-modal-title" style="font-size: 15px; font-weight: 700; margin: 0;">Chi tiết Job</h4>
            <span id="job-detail-modal-sub" style="font-size: 11px; color: #94a3b8;"></span>
          </div>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="closeJobDetailModal()">✕ Đóng</button>
      </div>
      <div class="app-modal-body" id="job-detail-modal-body" style="padding: 20px; max-height: 70vh; overflow-y: auto;">
        <!-- Dynamic content -->
      </div>
      <div class="app-modal-footer" style="padding: 12px 20px; border-top: 1px solid #23304d; background: #0f172a; display: flex; justify-content: flex-end; gap: 10px;">
        <button class="btn btn-secondary" onclick="closeJobDetailModal()">Đóng</button>
      </div>
    </div>
  </div>


  <!-- MODAL XUẤT BẢN & LÊN LỊCH REELS (LoHa Page Architecture) -->
  <div id="modal-publish-reel" class="app-modal-overlay" style="display: none;">
    <div class="app-modal-box" style="max-width: 680px; width: 95%;">
      <div class="app-modal-header" style="background: #0b1329; border-bottom: 1px solid #23304d; display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 16px; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px; color: #38bdf8;">
          <i class="bi bi-send-check-fill"></i> Xuất bản & Lên lịch Reels (Meta Graph API v22.0)
        </h3>
        <button class="app-modal-close" onclick="closePublishModal()" style="background: none; border: none; color: #94a3b8; font-size: 20px; cursor: pointer;">&times;</button>
      </div>
      <div class="app-modal-body" style="padding: 20px;">
        
        <!-- Video File info -->
        <div style="background: #0f172a; border: 1px solid #1e293b; border-radius: 8px; padding: 10px 14px; margin-bottom: 15px; display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <i class="bi bi-file-earmark-play-fill" style="color: #38bdf8; font-size: 1.4rem;"></i>
            <div>
              <div id="pub-clip-title" style="font-size: 13px; font-weight: 700; color: #f1f5f9;">Clip Highlight</div>
              <div id="pub-clip-filename" style="font-size: 11px; color: #64748b; font-family: monospace;">output_clip.mp4</div>
            </div>
          </div>
          <span class="badge" style="background: rgba(34, 197, 94, 0.15); color: #22c55e; font-size: 11px; padding: 4px 8px; border-radius: 4px;">SẴN SÀNG ĐĂNG</span>
        </div>

        <!-- Target Destination (Page hoặc Nhóm) -->
        <div style="margin-bottom: 15px;">
          <label class="form-label" style="font-size: 12px; font-weight: 700; color: #cbd5e1;">1. Chọn Fanpage hoặc Nhóm vệ tinh (LoHa Model):</label>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 8px;">
            <div>
              <label style="font-size: 11px; color: #94a3b8;">Chọn theo Nhóm Page:</label>
              <select id="pub-select-group" class="form-select" style="font-size: 12px; background: #0f172a; border-color: #334155;" onchange="onPubGroupChanged()">
                <option value="">-- Chọn nhóm trang vệ tinh --</option>
              </select>
            </div>
            <div>
              <label style="font-size: 11px; color: #94a3b8;">Hoặc chọn Trang đơn lẻ:</label>
              <select id="pub-select-single-page" class="form-select" style="font-size: 12px; background: #0f172a; border-color: #334155;">
                <option value="">-- Chọn 1 Fanpage cụ thể --</option>
              </select>
            </div>
          </div>
          <!-- Multiple pages preview container -->
          <div id="pub-pages-target-summary" style="font-size: 11.5px; color: #38bdf8; background: #070d1e; padding: 6px 12px; border-radius: 6px; border: 1px dashed #1e293b;">
            <i class="bi bi-info-circle"></i> Vui lòng chọn nhóm hoặc 1 Fanpage để tiến hành đăng.
          </div>
        </div>

        <!-- Nội dung bài đăng (Caption) -->
        <div style="margin-bottom: 15px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <label class="form-label" style="font-size: 12px; font-weight: 700; color: #cbd5e1; margin-bottom: 0;">2. Tiêu đề & Nội dung Facebook Reel:</label>
            <span style="font-size: 11px; color: #64748b;">Hỗ trợ Hashtags</span>
          </div>
          <textarea id="pub-caption" class="form-control" rows="4" style="font-size: 12.5px; line-height: 1.4; background: #0f172a; border-color: #334155;" placeholder="Nội dung status đính kèm clip Reel..."></textarea>
        </div>

        <!-- First Comment viral & link web -->
        <div style="margin-bottom: 15px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
            <label class="form-label" style="font-size: 12px; font-weight: 700; color: #f59e0b; margin-bottom: 0;">
              <i class="bi bi-chat-left-text-fill"></i> 3. First Comment tự động (Kèm Link website kéo traffic):
            </label>
            <button class="btn btn-outline-secondary btn-sm" style="font-size: 10.5px; padding: 1px 6px;" onclick="insertWebsiteLinkToFirstComment()">
              <i class="bi bi-link-45deg"></i> Chèn link Web cấu hình
            </button>
          </div>
          <input type="text" id="pub-first-comment" class="form-control" style="font-size: 12.5px; background: #0f172a; border-color: #334155;" placeholder="Bình luận đầu tiên tạo tò mò + link website (VD: Xem bản nét căng tại https://...)">
        </div>

        <!-- Chế độ Xuất bản / Lên lịch (Schedule) -->
        <div style="background: #091124; border: 1px solid #1e293b; border-radius: 8px; padding: 14px; margin-bottom: 15px;">
          <label class="form-label" style="font-size: 12px; font-weight: 700; color: #cbd5e1; margin-bottom: 10px;">4. Chế độ đăng bài:</label>
          <div style="display: flex; gap: 20px; align-items: center; margin-bottom: 10px;">
            <label style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; cursor: pointer; color: #22c55e; font-weight: 600;">
              <input type="radio" name="pub_mode" value="now" checked onchange="toggleScheduleOptions()"> 
              <i class="bi bi-lightning-charge-fill"></i> Đăng ngay (Publish Now)
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 12.5px; cursor: pointer; color: #a855f7; font-weight: 600;">
              <input type="radio" name="pub_mode" value="schedule" onchange="toggleScheduleOptions()"> 
              <i class="bi bi-calendar-event-fill"></i> Hẹn giờ lên lịch (Meta Scheduled)
            </label>
          </div>

          <!-- Schedule Options Form (Ẩn/Hiện) -->
          <div id="pub-schedule-box" style="display: none; padding-top: 10px; border-top: 1px dashed #1e293b;">
            <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 12px;">
              <div>
                <label style="font-size: 11px; color: #94a3b8;">Thời gian bắt đầu đăng (Giờ hệ thống):</label>
                <input type="datetime-local" id="pub-schedule-datetime" class="form-control" style="font-size: 12px; background: #0f172a; border-color: #334155;">
                <div style="font-size: 10.5px; color: #64748b; margin-top: 3px;">* Meta yêu cầu tối thiểu sau hiện tại 15 phút.</div>
              </div>
              <div>
                <label style="font-size: 11px; color: #94a3b8;">Giãn cách giữa các Page (Stagger):</label>
                <select id="pub-schedule-stagger" class="form-select" style="font-size: 12px; background: #0f172a; border-color: #334155;">
                  <option value="5">Giãn cách 5 phút</option>
                  <option value="10">Giãn cách 10 phút</option>
                  <option value="15" selected>Giãn cách 15 phút (Khuyên dùng)</option>
                  <option value="20">Giãn cách 20 phút</option>
                  <option value="30">Giãn cách 30 phút</option>
                </select>
                <div style="font-size: 10.5px; color: #64748b; margin-top: 3px;">Tránh đăng đồng loạt bị đánh spam.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Result / Feedback Banner -->
        <div id="pub-status-banner" style="display: none; padding: 12px; border-radius: 8px; font-size: 12px; margin-bottom: 15px;"></div>

        <div style="display: flex; justify-content: flex-end; gap: 10px; border-top: 1px solid #23304d; padding-top: 15px;">
          <button class="btn btn-secondary" onclick="closePublishModal()">Hủy bỏ</button>
          <button id="btn-execute-publish" class="btn btn-primary" style="background: linear-gradient(135deg, #0ea5e9, #2563eb); border:none; font-weight: 700; padding: 8px 24px;" onclick="executePublishReel()">
            <i class="bi bi-send-check"></i> Xác nhận Đăng Reel
          </button>
        </div>

      </div>
    </div>
  </div>

</body>
</html>