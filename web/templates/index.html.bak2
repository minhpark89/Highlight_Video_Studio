            <span style="font-size: 11px; color: #94a3b8;">Xem video gốc trực tiếp không cần rời trang</span>
          </div>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="closeVideoPlayerModal()" style="border-radius: 50%; width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center;">
          <i class="bi bi-x-lg"></i>
