        </div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; flex-wrap: wrap; gap: 10px;">
          <div style="display: flex; gap: 8px;">
            <button id="modal-copy-url-btn" class="btn btn-secondary btn-sm" onclick="copyModalVideoUrl()">
              <i class="bi bi-clipboard-check"></i> <span>Sao chép Link</span>
            </button>
            <button id="modal-send-cut-btn" class="btn btn-primary btn-sm" onclick="sendModalUrlToRender()" style="background: linear-gradient(135deg, #f59e0b, #d97706); border: none;">
              <i class="bi bi-scissors"></i> <span>Ném vào Cắt Highlight</span>
            </button>
          </div>
          <button class="btn btn-secondary btn-sm" onclick="openContentWriterFromPlayer()" style="background: rgba(168, 85, 247, 0.2); border-color: rgba(168, 85, 247, 0.4); color: #c084fc;">
            <i class="bi bi-magic"></i> Viết bài & First Comment cho video này
          </button>
        </div>
      </div>
    </div>
  </div>

  
  <!-- MODAL 3: THÊM TOKEN MỚI (LoHa Architecture) -->
  <div id="modal-add-token" class="app-modal-overlay">
    <div class="app-modal-box" style="max-width: 540px;">
      <div class="app-modal-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(245, 158, 11, 0.2); color: #f59e0b; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-key-fill"></i>
          </div>
          <div>
            <h4 style="font-size: 15px; font-weight: 700; margin: 0;">Thêm Access Token Meta</h4>
            <span style="font-size: 11px; color: #94a3b8;">Khuyên dùng System User Token (BM) vĩnh viễn không hết hạn</span>
          </div>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="closeAddTokenModal()" style="border-radius: 50%; width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center;">
          <i class="bi bi-x-lg"></i>
        </button>
      </div>
      <div class="app-modal-body">
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div>
            <label class="form-label" style="font-size: 12px; font-weight: 600; color: #94a3b8;">Tên gợi nhớ (Mặc định):</label>
            <input type="text" id="token-input-name" class="form-control" placeholder="Ví dụ: System BM Chính (Để trống sẽ tự đặt Token 1, 2...)">
          </div>
          <div>
            <label class="form-label" style="font-size: 12px; font-weight: 600; color: #94a3b8;">Loại Token:</label>
            <select id="token-input-kind" class="form-control">
              <option value="SYS" selected>System User Token (BM - Khuyên dùng, không hết hạn)</option>
              <option value="PAGE">Page Access Token</option>
              <option value="USER">User Access Token</option>
            </select>
          </div>
          <div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
              <label class="form-label" style="font-size: 12px; font-weight: 600; color: #94a3b8; margin: 0;">Dán Token hoặc Danh sách Token (Mỗi dòng 1 token):</label>
              <span class="badge" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8; font-size: 10px;">Hỗ trợ dán hàng loạt</span>
            </div>
            <textarea id="token-input-str" class="form-control" rows="5" placeholder="Dán 1 hoặc nhiều token (mỗi dòng 1 token):&#10;EAAB...&#10;Hoặc định dạng: Tên|EAAB...&#10;Token_Chính|EAAB...&#10;Token_Phụ|EAAB..."></textarea>
          </div>
          <div style="font-size: 11.5px; color: #38bdf8; line-height: 1.4; background: rgba(56,189,248,0.08); padding: 8px 12px; border-radius: 6px; border: 1px dashed rgba(56,189,248,0.3);">
            <i class="bi bi-magic"></i> <b>Batch Auto-Sync:</b> Hệ thống sẽ tự động duyệt từng token, gọi Meta Graph API v22.0 kiểm tra trạng thái và đồng bộ tất cả Fanpage về một lượt!
          </div>
        </div>
      </div>
      <div class="app-modal-footer" style="padding: 15px 20px; border-top: 1px solid #23304d; background: #0f172a; display: flex; justify-content: flex-end; gap: 10px;">
